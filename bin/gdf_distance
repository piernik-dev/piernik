#!/usr/bin/env python3
import argparse
import h5py as h5
import numpy as np
import math
import sys
import logging
import re
from typing import Dict, List, Tuple

sp_key = 'simulation_parameters'
pkeys = [['position_x', 'position_y', 'position_z'],
         ['velocity_x', 'velocity_y', 'velocity_z'],
         ['acceleration_x', 'acceleration_y', 'acceleration_z'],
         ['energy'],
         ['mass'],
         ['dynamical_time'],
         ['formation_time']]
pkeys_flat = {key for group in pkeys for key in group}
auto_vectors = True

logging.basicConfig(level=logging.INFO, format='%(levelname)s: %(message)s')


def is_comparable(fname1: str, fname2: str) -> bool:
    status = True
    v_key = 'piernik'
    ver = {}
    try:
        h5f1 = h5.File(fname1, "r")
        h5f2 = h5.File(fname2, "r")
    except IOError as e:
        logging.error(f"IOError: {e}")
        return False

    for f in (h5f1, h5f2):
        # piernik versions
        ver[f.filename] = f.attrs[v_key][0]
        if int(ver[f.filename]) != 2:
            logging.error(f"Only Piernik v2 HDF (GDF) files are supported, not {ver[f.filename]}.")
            status = False

        # Check for some refinement constraints
        levl = set(f["grid_level"])
        if 0 not in levl:
            logging.error(f"Cannot find base level in '{f.filename}'.")
            status = False
        if set(range(max(levl) + 1)) != levl:
            logging.error(f"Missing levels in '{f.filename}'.")
            status = False
        if len(levl) > 1 and f[sp_key].attrs["refine_by"][0] != 2:
            logging.error(f"Only refine factor of 2 is supported. Cannot interpret '{f.filename}'.")
            status = False

    if len(set(map(int, map(float, ver.values())))) > 1:
        logging.error(f"Cannot compare different major file format revisions: {list(ver.values())}")
        status = False

    if len(set(ver.values())) > 1:
        logging.warning("Different revisions of Piernik HDF format. Expect troubles.")

    for f in (h5f1, h5f2):
        f.close()

    return status


def compare_domains(h5f1: h5.File, h5f2: h5.File) -> Tuple[float, np.ndarray, np.ndarray]:
    dle_key = 'domain_left_edge'
    dre_key = 'domain_right_edge'
    try:
        dl1, dr1 = h5f1[sp_key].attrs[dle_key], h5f1[sp_key].attrs[dre_key]
    except KeyError as e:
        logging.error(f"KeyError: {e} (`{h5f1.filename}`:{sp_key}:{dle_key},{dre_key}).")
        exit(10)
    try:
        dl2, dr2 = h5f2[sp_key].attrs[dle_key], h5f2[sp_key].attrs[dre_key]
    except KeyError as e:
        logging.error(f"KeyError: {e} (`{h5f2.filename}`:{sp_key}:{dle_key},{dre_key}).")
        exit(10)

    # find overlapped area
    dlo = np.maximum(dl1, dl2)
    dro = np.minimum(dr1, dr2)

    if np.any(dro < dlo):
        logging.error("Domains don't overlap.")
        return 1., np.zeros(3), np.zeros(3)

    def log_volume(left, right):
        widths = []
        for lo, hi in zip(left, right):
            lo, hi = float(lo), float(hi)
            if hi <= lo:
                return -math.inf
            if lo < 0. < hi:
                larger, smaller = max(-lo, hi), min(-lo, hi)
                widths.append(math.log(larger) + math.log1p(smaller / larger))
            else:
                widths.append(math.log(hi - lo))
        return math.fsum(widths)

    log_1 = log_volume(dl1, dr1)
    log_2 = log_volume(dl2, dr2)
    log_o = log_volume(dlo, dro)
    if log_1 == -math.inf and log_2 == -math.inf:
        logging.error("Both domains have no volume!")
        exit(11)
    if log_o == -math.inf:
        return 1., dlo, dro

    # Normalize logarithmic volumes before forming the intersection-over-union ratio.
    log_o = min(log_o, log_1, log_2)
    scale = max(log_1, log_2)
    vol_1, vol_2, vol_o = (math.exp(value - scale) for value in (log_1, log_2, log_o))
    return 1. - vol_o / (vol_1 + vol_2 - vol_o), dlo, dro


def compare_resolution(h5f1: h5.File, h5f2: h5.File) -> float:
    dim_key = "domain_dimensions"

    try:
        res1 = h5f1[sp_key].attrs[dim_key]
    except KeyError as e:
        logging.error(f"KeyError: {e} (`{h5f1.filename}`:{sp_key}:{dim_key}).")
        exit(30)
    try:
        res2 = h5f2[sp_key].attrs[dim_key]
    except KeyError as e:
        logging.error(f"KeyError: {e} (`{h5f2.filename}`:{sp_key}:{dim_key}).")
        exit(30)

    r_norm = 0.
    for i in range(len(res1)):
        r_norm = 1. - (1. - r_norm) * (1. - abs(res1[i] - res2[i]) / float(res1[i] + res2[i]))

    return r_norm


def compare_dlists(h5f1: h5.File, h5f2: h5.File) -> Tuple[float, List[List[str]]]:
    d_key = '/data'
    g0_key = 'grid_0000000000'  # trick: GDF has to contain this grid id

    f1 = list(h5f1[d_key][g0_key].keys())
    f2 = list(h5f2[d_key][g0_key].keys())

    # Particles should be handled separately
    for f in (f1, f2):
        if "particles" in f:
            f.remove("particles")

    f1 = [canonical_field_name(f) for f in f1]
    f2 = [canonical_field_name(f) for f in f2]
    fc = sorted(set(f1) & set(f2))
    if len(fc) != len(f1):
        logging.info(f"Fields unique for `{h5f1.filename}`: {list(set(f1) ^ set(fc))}")
    if len(fc) != len(f2):
        logging.info(f"Fields unique for `{h5f2.filename}`: {list(set(f2) ^ set(fc))}")

    v0 = []
    for f in fc:
        if f[-1] == 'x' or f[-2:-1] == 'x' or f[-2:] == '01':
            v0.append(f)

    vec = []
    for v in v0:
        vv = []
        if v[-1] == 'x':
            vv = [v]
            for f in fc:
                for i in ('y', 'z'):
                    if f == v[:-1] + i:
                        vv.append(f)
        elif v[-2:-1] == 'x':
            vv = [v]
            for f in fc:
                for i in ('y', 'z'):
                    if f == v[:-2] + i + v[-1]:
                        vv.append(f)
        elif v[-2:] == '01':
            digit2 = re.compile(v[:-2].replace("+", "\\+") + "[0-9][0-9]").search
            for f in fc:
                if bool(digit2(f)):
                    vv.append(f)
        else:
            logging.error(f"Unsupported case {v}")
            exit(40)

        if len(vv) > 1:
            vec.append(vv)

    b = []
    disjoint_vec = []
    for v in vec:
        remaining = [f for f in v if f not in b]
        if len(remaining) > 1:
            disjoint_vec.append(remaining)
            b += remaining
    vec = disjoint_vec
    if len(vec) > 0:
        logging.info("Possible vectors:")
        for v in vec:
            logging.info(f"    {sorted(v)}")
        logging.info(f"Remaining fields:")
        logging.info(f"    {list(set(fc) ^ set(b))}")

    if auto_vectors:
        for v in sorted(set(fc) - set(b)):
            vec.append([v])
    else:
        vec = []
        for v in fc:
            vec.append([v])

    return 0. if set(f1) == set(f2) else 1., vec


def canonical_field_name(name: str) -> str:
    return name.replace("cre", "cr_e-", 1) if re.match(r"^cre[en][0-9][0-9]", name) else name


def compare_time(h5f1: h5.File, h5f2: h5.File) -> float:
    time_key = "time"
    t1 = h5f1.attrs[time_key][0]
    t2 = h5f2.attrs[time_key][0]
    if not np.isfinite(t1) or not np.isfinite(t2):
        raise ValueError("Simulation times must be finite.")
    if (t1 < 0. < t2) or (t2 < 0. < t1):
        logging.warning(f"Comparing times with opposite signs: {t1} and {t2}; negative simulation time detected.")
        return 1.
    scale = max(abs(t1), abs(t2))
    if scale == 0.:
        return 0.
    result = (abs(t1 - t2) / scale) / (abs(t1 / scale) + abs(t2 / scale))
    if result == 0. and t1 != t2:
        raise ValueError("Simulation time difference underflowed.")
    return result


def compare_data(ds1: np.ndarray, ds2: np.ndarray) -> float:
    # This norm is:
    #   0. when n1 == n2
    #   1. when one field is non-0. and the other is 0.
    #   1. when one field is proportional to the other but with negative coefficient
    #   epsilon/2 when difference between fields is epsilon

    # When np.shape(ds1)[0] > 1 (the data is vector, not scalar), the formula doesn't change because we use the default, Frobenius norm.

    if not np.isfinite(ds1).all() or not np.isfinite(ds2).all():
        raise ValueError("Compared data must be finite.")
    scale = max(np.max(np.abs(ds1), initial=0.), np.max(np.abs(ds2), initial=0.))
    if scale == 0.:
        return 0.
    scaled1 = ds1 / scale
    scaled2 = ds2 / scale
    n1 = np.linalg.norm(scaled1)
    n2 = np.linalg.norm(scaled2)
    nd = np.linalg.norm(scaled1 - scaled2)
    result = nd / (n1 + n2)
    if result == 0. and not np.array_equal(ds1, ds2):
        raise ValueError("Data difference underflowed.")
    return result


def collect_dataset(h5f: h5.File, dset_name: List[str], level: int) -> Tuple[np.ndarray, List[int], bool]:
    attrs = h5f['domains']['base'].attrs
    nd = [i * 2**level for i in attrs['n_d']]
    dset = np.zeros((len(dset_name), nd[0], nd[1], nd[2]))

    levelmet = False
    for ig in range(int(h5f['data'].attrs['cg_count'][0])):
        h5g = h5f['data']['grid_' + str(ig).zfill(10)]
        if h5g.attrs['level'] == level:
            levelmet = True
            off = h5g.attrs['off']
            ngb = h5g.attrs['n_b']
            n_b = [int(ngb[0]), int(ngb[1]), int(ngb[2])]
            ce = n_b + off
            for i in range(len(dset_name)):
                if dset_name[i] in h5g:
                    ds = dset_name[i]
                elif dset_name[i].replace("cr_e-", "cre") in h5g:
                    ds = dset_name[i].replace("cr_e-", "cre")
                else:
                    raise KeyError
                dset[i, off[0]:ce[0], off[1]:ce[1], off[2]:ce[2]] = h5g[ds][:, :, :].swapaxes(0, 2)

    return dset, nd, levelmet


def get_particles(h5f: h5.File) -> Dict[str, np.ndarray]:
    plist = {}
    if "grid_particle_count" not in h5f:
        return plist
    n = int(np.sum(h5f['grid_particle_count']))
    nf = 0
    for ig in range(h5f['grid_dimensions'].shape[0]):
        h5g = h5f['data']['grid_' + str(ig).zfill(10)]
        if "particles" in h5g:
            if "stars" in h5g["particles"]:
                h5gps = h5g["particles"]["stars"]
                nf += h5gps.attrs['n_part'][0]
                for v in h5gps.keys():
                    if v not in plist:
                        plist[v] = []
                    plist[v].append(h5gps[v][:])
    if nf != n:
        logging.warning(f"Read {nf} particles from '{h5f.filename}', {n} expected.")
    else:
        logging.info(f"Read {nf} particles from '{h5f.filename}'.")

    plist = {v: np.concatenate(parts) for v, parts in plist.items()}
    for v in plist:
        if len(plist[v]) != n:
            raise ValueError(f"Incomplete list for particle quantity '{v}' in '{h5f.filename}': read {len(plist[v])} out of {n}.")
    if "id" in plist.keys():
        if set(plist.keys()) != (pkeys_flat | {'id'}):
            logging.warning(f"Non-standard set of particle quantities detected in '{h5f.filename}': {set(plist.keys())}")
    if n != nf or (n and not (pkeys_flat | {'id'}).issubset(plist)):
        raise ValueError(f"Incomplete particle data in '{h5f.filename}'.")
    if n:
        ids = plist['id']
        integer_ids = np.issubdtype(ids.dtype, np.integer)
        if np.issubdtype(ids.dtype, np.floating):
            integer_ids = np.isfinite(ids).all() and np.equal(ids, np.trunc(ids)).all()
        if not integer_ids or len({int(i) for i in ids}) != n:
            raise ValueError(f"Particle IDs must be unique integers in '{h5f.filename}'.")
    return plist


def convert_particles(p: Dict[str, np.ndarray]) -> Dict[int, Dict[str, float]]:
    pp = {}
    for i in range(len(p["id"])):
        particle_id = int(p["id"][i])
        pp[particle_id] = {}
        for k in pkeys_flat:
            pp[particle_id][k] = p[k][i]
    return pp


# I'm afraid this might be quite slow on large particle sets
def compare_particles(h5f1: h5.File, h5f2: h5.File) -> Dict[str, float]:
    pn = {}
    p1 = get_particles(h5f1)
    p2 = get_particles(h5f2)
    if "id" not in p1 and "id" not in p2:
        return pn
    if "id" not in p1 or "id" not in p2:
        pn["particles exists"] = 1.
        return pn
    if len(p1["id"]) == 0 and len(p2["id"]) == 0:
        return pn
    if {int(i) for i in p1["id"]} != {int(i) for i in p2["id"]}:
        pn["particles id"] = 1.
        return pn

    pp1 = convert_particles(p1)
    pp2 = convert_particles(p2)

    n_comm_p = len(set(pp1.keys()) & set(pp2.keys()))
    pn["particles id"] = 0.

    tot_datanorm = 0.
    groups = pkeys if auto_vectors else [[key] for key in sorted(pkeys_flat)]
    for kv in groups:
        ds1 = np.zeros((n_comm_p * len(kv)))
        ds2 = np.zeros((n_comm_p * len(kv)))
        i = 0
        for particle_id in sorted(pp1):
            for k in kv:
                ds1[i] = pp1[particle_id][k]
                ds2[i] = pp2[particle_id][k]
                i += 1
        norm = compare_data(ds1, ds2)
        # Assumed that the only vectors for particles are the XYZ-vectors
        pn[f"particles `{kv[0] if len(kv) == 1 else kv[0][:-2] + '_[x..z]'}`"] = norm
        tot_datanorm = 1. - (1. - tot_datanorm) * (1. - norm)
    logging.info(f"All particles difference: {tot_datanorm}")

    return pn


def dataset_structure(h5f: h5.File, selected_level=None) -> tuple:
    params = h5f[sp_key].attrs
    edges = np.concatenate((params['domain_left_edge'], params['domain_right_edge']))
    if len(edges) != 6 or not np.isfinite(edges).all() or np.any(edges[3:] <= edges[:3]):
        raise ValueError(f"Invalid domain edges in '{h5f.filename}'.")
    base_dims = tuple(int(n) for n in h5f['domains']['base'].attrs['n_d'])
    if len(base_dims) != 3 or any(n <= 0 for n in base_dims):
        raise ValueError(f"Invalid base dimensions in '{h5f.filename}'.")
    dimensions = tuple(int(n) for n in params['domain_dimensions'])
    if len(dimensions) != 3 or any(n <= 0 for n in dimensions):
        raise ValueError(f"Invalid domain dimensions in '{h5f.filename}'.")
    grid_levels = [int(level) for level in h5f['grid_level']]
    levels = sorted(set(grid_levels)) if selected_level is None else [selected_level]
    if any(level not in grid_levels for level in levels):
        raise ValueError(f"Selected level not found in '{h5f.filename}'.")
    masks = {level: np.zeros(tuple(n * 2**level for n in base_dims), dtype=bool) for level in levels}
    fields = None
    count = int(h5f['data'].attrs['cg_count'][0])
    if count != len(grid_levels):
        raise ValueError(f"Inconsistent grid count in '{h5f.filename}'.")
    for ig, level in enumerate(grid_levels):
        grid = h5f['data']['grid_' + str(ig).zfill(10)]
        if int(np.asarray(grid.attrs['level']).item()) != level:
            raise ValueError(f"Inconsistent grid level in '{h5f.filename}'.")
        names = [canonical_field_name(name) for name in grid.keys() if name != 'particles']
        if len(set(names)) != len(names):
            raise ValueError(f"Duplicate canonical field names in '{h5f.filename}'.")
        if fields is None:
            fields = tuple(sorted(names))
        elif fields != tuple(sorted(names)):
            raise ValueError(f"Grid field lists differ within '{h5f.filename}'.")
        if level not in masks:
            continue
        mask = masks[level]
        off = tuple(int(x) for x in grid.attrs['off'])
        size = tuple(int(x) for x in grid.attrs['n_b'])
        if (len(off) != 3 or len(size) != 3 or
                any(o < 0 or n <= 0 or o + n > bound for o, n, bound in zip(off, size, mask.shape))):
            raise ValueError(f"Invalid grid bounds in '{h5f.filename}'.")
        region = tuple(slice(o, o + n) for o, n in zip(off, size))
        if mask[region].any():
            raise ValueError(f"Overlapping grids on the same level in '{h5f.filename}'.")
        mask[region] = True
    particles = get_particles(h5f)
    particle_ids = tuple(sorted(int(i) for i in particles.get('id', [])))
    return (int(params['dimensionality'][0]), int(params['geometry'][0]),
            tuple(edges), dimensions, base_dims, fields,
            tuple((level, masks[level].tobytes()) for level in levels), particle_ids)


def base_compare(h5f1: h5.File, h5f2: h5.File) -> Tuple[Dict[str, float], List[List[str]]]:
    norms = {}
    # compare time
    norms["time"] = compare_time(h5f1, h5f2)

    # compare domains
    norms["domains"], dlo, dro = compare_domains(h5f1, h5f2)

    # compare resolution
    norms["resolution"] = compare_resolution(h5f1, h5f2)

    # compare boundary types
    norms["boundary types (not checked)"] = 0.

    # compare datafield lists
    norms["datafield lists"], common_fields = compare_dlists(h5f1, h5f2)

    # compare particles
    norms.update(compare_particles(h5f1, h5f2))

    if norms["domains"] < 1.:
        norms["AMR structure"] = 0.

    if not (norms["domains"] == 0 and norms["resolution"] == 0):
        logging.error("Comparing domains of different size or resolution is not implemented yet")
        exit(31)

    return norms, common_fields


def compare_datafields_by_level(h5f1: h5.File, h5f2: h5.File, levels: Tuple[int, int], common_fields: List[List[str]],
                                fname1: str, fname2: str, print_fname: bool) -> Dict[str, float]:
    lnorm = {}
    # No error checking here, fail in ugly way when is_comparable does not
    # prevent attempt to open these files.

    tot_datanorm = 0.
    for f in common_fields:
        ds1, nd1, levok1 = collect_dataset(h5f1, f, levels[0])
        ds2, nd2, levok2 = collect_dataset(h5f2, f, levels[1])
        if not levok1:
            print('Level %s not met in %s.' % (levels[0], fname1))
            exit(51)
        if not levok2:
            print('Level %s not met in %s.' % (levels[1], fname2))
            exit(52)
        if nd1[0] != nd2[0] or nd1[1] != nd2[1] or nd1[2] != nd2[2]:
            print('Domain shape for %s level %s: %s' % (fname1, levels[0], nd1))
            print('Domain shape for %s level %s: %s' % (fname2, levels[1], nd2))
            print('Arrays cannot be compered.')
            exit(53)
        norm = compare_data(ds1, ds2)
        if len(f) == 1:
            fld_name = f[0]
        else:
            if sorted(f)[0][-1] == 'x':
                fld_name = sorted(f)[0][:-1] + '[x..' + sorted(f)[-1][-1] + ']'
            elif sorted(f)[0][-2] == 'x':
                fld_name = sorted(f)[0][:-2] + '[x..' + sorted(f)[-1][-2] + ']' + sorted(f)[0][-1]
            elif sorted(f)[0][-2:] == '01':
                fld_name = sorted(f)[0][:-2] + '[01..' + sorted(f)[-1][-2:] + ']'
            else:
                fld_name = '[' + sorted(f)[0] + ".." + sorted(f)[-1] + ']'
        key = "datafield `" + fld_name + "'"
        if key in lnorm:
            raise ValueError(f"Ambiguous field group name '{fld_name}'.")
        lnorm[key] = norm
        tot_datanorm = 1. - (1. - tot_datanorm) * (1. - norm)
    if levels[0] == levels[1]:
        lev = str(levels[0])
    else:
        lev = str(levels[0]) + ' vs. ' + str(levels[1])
    print("All datafield difference%s on grid level %s: %g" % (
        (" between '%s' and '%s'" % (fname1, fname2)) if print_fname else "",
        lev, tot_datanorm))

    return lnorm


def piernik_gdf_compare(fname1, fname2, levels, print_fname=False):
    with h5.File(fname1, "r") as h5f1, h5.File(fname2, "r") as h5f2:
        level1, level2 = (None, None) if levels == [] else levels
        if dataset_structure(h5f1, level1) != dataset_structure(h5f2, level2):
            return {"structure": 1.}, [{}], range(1)

        normsl = []
        norms, common_fields = base_compare(h5f1, h5f2)
        if levels == []:
            nlev = range(max(h5f1['grid_level']) + 1)
            for lev in nlev:
                normsl.append(compare_datafields_by_level(h5f1, h5f2, (lev, lev), common_fields, fname1, fname2, print_fname))
        else:
            normsl.append(compare_datafields_by_level(h5f1, h5f2, levels, common_fields, fname1, fname2, print_fname))
            nlev = range(1)
        return norms, normsl, nlev


def n_reduce(args):
    norms, normsl, nlev = args
    n = {}
    for i in sorted(norms.keys()):
        n[i] = norms[i]
    for i in sorted(normsl[0].keys()):
        for lev in nlev:
            if i in n:
                n[i] += (1. - n[i]) * normsl[lev][i]
            else:
                n[i] = normsl[lev][i]

    return n


if __name__ == "__main__":
    import sys

    # Ugly. ToDo: rewrite and use argparse.
    novec = "--novec"
    if novec in sys.argv:
        sys.argv.remove(novec)
        auto_vectors = False
        sys.stderr.write("Switched to nondetection of vectors\n")
    if (len(sys.argv) < 3):
        sys.stderr.write("Error: too few arguments.\nUsage: " +
                         sys.argv[0] + " piernik_data_hdf_file1 piernik_data_hdf_file2 [piernik_data_hdf_file3]\n" + "or     " +
                         sys.argv[0] + " piernik_data_hdf_file1 piernik_data_hdf_file2 level1 level2\n")
        exit(1)

    if (len(sys.argv) == 3) or (len(sys.argv) == 5):
        if (is_comparable(sys.argv[1], sys.argv[2])):
            if (len(sys.argv) == 5):
                levels = [int(sys.argv[3]), int(sys.argv[4])]
            else:
                levels = []
            norms, normsl, nlev = piernik_gdf_compare(sys.argv[1], sys.argv[2], levels)
            tot_norm = 0.
            failed = False
            longestkey = max((len(key) for key in (*norms, *normsl[0])), default=0)
            for i in sorted(norms.keys()):
                toprint = "Difference of %-*s:" % (longestkey + 1, i)
                if (norms[i] >= 0. and norms[i] <= 1. + 1e-12):
                    toprint = toprint + "   %14g" % norms[i]
                    # tot_norm = 1. - (1. - tot_norm) * (1. - norms[i])
                    tot_norm += (1. - tot_norm) * norms[i]
                else:
                    print("Difference measure `%s` out of [0,1] range: %g" %
                          (i, norms[i]))
                    failed = True
                if not failed:
                    print(toprint)
            for i in sorted(normsl[0].keys()):
                toprint = "Difference of %-*s:" % (longestkey + 1, i)
                for lev in nlev:
                    if (normsl[lev][i] >= 0. and normsl[lev][i] <= 1. + 1e-12):
                        toprint = toprint + "   %14g" % normsl[lev][i]
                        # tot_norm = 1. - (1. - tot_norm) * (1. - norms[i])
                        tot_norm += (1. - tot_norm) * normsl[lev][i]
                    else:
                        print("Difference measure `%s` out of [0,1] range: %g" %
                              (i, normsl[lev][i]))
                        failed = True
                if not failed:
                    print(toprint)
            if (failed):
                print("Comparison of `%s' and `%s' failed" %
                      (sys.argv[1], sys.argv[2]))
                exit(3)
            else:
                print("Total difference between `%s' and `%s': %g" %
                      (sys.argv[1], sys.argv[2], tot_norm))
        else:
            print("Cannot compare files `%s' and `%s'" %
                  (sys.argv[1], sys.argv[2]))
            exit(2)
    elif (len(sys.argv) == 4) or (len(sys.argv) == 7):
        if (is_comparable(sys.argv[1], sys.argv[2]) and is_comparable(sys.argv[1], sys.argv[3])):
            if (len(sys.argv) == 7):
                l12 = [int(sys.argv[4]), int(sys.argv[5])]
                l13 = [int(sys.argv[4]), int(sys.argv[6])]
                l23 = [int(sys.argv[5]), int(sys.argv[6])]
            else:
                l12, l13, l23 = [], [], []
            n12 = n_reduce(piernik_gdf_compare(sys.argv[1], sys.argv[2], l12, print_fname=True))
            print("")
            n13 = n_reduce(piernik_gdf_compare(sys.argv[1], sys.argv[3], l13, print_fname=True))
            print("")
            n23 = n_reduce(piernik_gdf_compare(sys.argv[2], sys.argv[3], l23, print_fname=True))
            print("")
            norms = dict(n12)
            norms.update(n13)
            norms.update(n23)
            longestkey = len(max(norms, key=len))
            print("Files:")
            for i in (1, 2, 3):
                print("  %d - %s" % (i, sys.argv[i]))
            print("Triangle construction:")
            print("  1: at (0, 0)")
            print("  2: at ('1-2', 0)")
            print("  3: at ('x', 'y')")
            print("\n%-*s: %-14s %-14s %-14s %-14s %-14s" % (longestkey + len("Difference of ") + 1, "distance type (all levels)", " 1-2", " 1-3", " 2-3", " x", " y"))
            # Of course it is possible to construct tetrahedrons for 4-way comparision
            c_red = '\033[91m'
            c_green = '\033[92m'
            c_reset = '\033[0m'
            c_gray = '\033[90m'
            for i in norms.keys():
                line = "Difference of %-*s: " % (longestkey + 1, i)
                comment = ""
                curnorm = []
                for nn in (n12, n13, n23):
                    if (i in nn):
                        curnorm.append(nn[i])
                lmin = min(curnorm)
                lmax = max(curnorm)
                for nn in (n12, n13, n23):
                    try:
                        color = ""
                        if (lmax > lmin):
                            if (nn[i] == lmax):
                                color = c_red
                            elif (nn[i] == lmin):
                                color = c_green
                        line += (" %s%-14g" % (color, nn[i])) + c_reset
                        if (nn[i] < 0. or nn[i] > 1.):
                            comment += " Value %g out of [0,1] range!" % nn[i]
                    except (KeyError):
                        line += c_gray + (" %14s" % "N/A") + c_reset
                if len(curnorm) < 3:
                    line += " %s%-14s %-14s" % (c_gray, "N/A", "N/A") + c_reset
                    print(line + comment)
                    continue
                if curnorm[0] == 0.:
                    x = curnorm[1]
                    y = 0.
                else:
                    x = (curnorm[0]**2 + curnorm[1]**2 - curnorm[2]**2) / (2. * curnorm[0])
                    y_squared = curnorm[1]**2 - x**2
                    if y_squared < -1.e-12:
                        logging.warning(f"Cannot construct triangle for '{i}': negative squared height {y_squared}.")
                        y = float('nan')
                    else:
                        y = math.sqrt(max(0., y_squared))
                line += " %s%-14g %-14g" % (c_gray, x, y) + c_reset
                print(line + comment)
        else:
            print("Cannot compare files `%s', `%s' and `%s'" %
                  (sys.argv[1], sys.argv[2], sys.argv[3]))
            exit(3)
    else:
        print("Too many arguments:", sys.argv)
        exit(4)
