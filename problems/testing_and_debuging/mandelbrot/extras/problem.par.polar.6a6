 $BASE_DOMAIN
    n_d = 128, 32, 1
    xmin   = -35
    xmax   =  1.
    ymin   =  -4.5 !-3.14159265 !0.
    ymax   =  1.7832 !3.14159265 !6.2831853
    bnd_xl = "outd"
    bnd_xr = "outd"
    bnd_yl = "outd"
    bnd_yr = "outd"
 /

 $UNITS
    units_set = "cgs"
 /

 $RESTART_CONTROL
    restart  = 'none'
    res_id   = ''
 /

 $END_CONTROL
    tend   = 0.0
    nend   = 0
 /

 $OUTPUT_CONTROL
    problem_name = 'mandelbrot_polar'
    run_id =  '6a6'
    use_v2_io = .true.
    dt_hdf  = 0.5
    vars(1:) = 'mand', 'dist', 'ang', 'level'
 /

 $PROBLEM_CONTROL
    maxiter = 50000
    ref_thr = 0.5
    !smooth_map = .false.
    log_polar = .true.
    precision = 'quad'
    x_center = "-1.99637859830127622318041140356304662056545479566444217157832784805"
    y_center = "-0.00009846411789164279281147049701099777327914008761108428659555385"

    c_polar = 0.26
 /

 $AMR
    bsize = 3*8
    level_max = 3
    n_updAMR = 1
 /

!../../visual/pvf.py mandelbrot_polar_6a6_0000.h5 -d mand -D nipy_spectral -z 1,2.5
