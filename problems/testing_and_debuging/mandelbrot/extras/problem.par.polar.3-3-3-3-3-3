 $BASE_DOMAIN
    n_d = 128, 16, 1
    xmin   = -16.
    xmax   =  1.
    ymin   =  0.
    ymax   =  6.2832
    bnd_xl = "outd"
    bnd_xr = "outd"
    bnd_yl = "outd"
    bnd_yr = "outd"
 /

 $UNITS
    units_set = "cgs"
 /

 $RESTART_CONTROL
    restart  = 'none'
    res_id   = ''
 /

 $END_CONTROL
    tend   = 0.0
    nend   = 0
 /

 $OUTPUT_CONTROL
    problem_name = 'mandelbrot_polar'
    run_id =  '3-3'
    use_v2_io = .true.
    dt_hdf  = 0.5
    vars(1:) = 'mand', 'dist', 'ang', 'level'
 /

 $PROBLEM_CONTROL
    maxiter = 300000
    !smooth_map = .false.
    log_polar = .true.
!    precision = "extended"
    x_center = "-0.1528467357297659946719258068485640647239765205"
    y_center = "1.0396951378330567087531697900475593748477585415"
    c_polar = 0.66
 /

 $AMR
    bsize = 3*8
    level_max = 3
    n_updAMR = 1
 /
