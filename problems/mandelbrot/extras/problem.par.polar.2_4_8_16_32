 $BASE_DOMAIN
    n_d = 128, 32, 1
    xmin   = -35
    xmax   =  1.
    ymin   =  -3.14159265 !0.
    ymax   =  3.14159265 !6.2831853
    bnd_xl = "outd"
    bnd_xr = "outd"
    bnd_yl = "outd"
    bnd_yr = "outd"
 /

 $UNITS
    units_set = "cgs"
 /

 $RESTART_CONTROL
    restart  = 'none'
    res_id   = ''
 /

 $END_CONTROL
    tend   = 0.0
    nend   = 0
 /

 $OUTPUT_CONTROL
    problem_name = 'mandelbrot_polar'
    run_id =  '2n_'
    use_v2_io = .true.
    dt_hdf  = 0.5
    vars(1:) = 'mand', 'dist', 'ang', 'level'
 /

 $PROBLEM_CONTROL
    maxiter = 200000
    !smooth_map = .false.
    log_polar = .true.
    precision = 'quad'
    ! This zoom peeks deeply into nested mandelbrot structures and thus it is
    ! quite slow in quad precision
    x_center = "-0.1528719009565961044726929242913352694564663551310107112319327"
    y_center = "-1.0403093367537139625747624283738382405293476514809075203506933"
    c_polar = 0.2
 /

 $AMR
    bsize = 3*8
    level_max = 3
    n_updAMR = 1
 /

! Visualisation example
! ../../visual/pvf.py mandelbrot_polar_2n__0000.h5 -d mand -D gist_ncar -z 1,6
