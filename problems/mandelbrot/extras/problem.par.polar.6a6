 $BASE_DOMAIN
    n_d = 128, 32, 1
    xmin   = -35
    xmax   =  1.
    ymin   =  -4.5 !-3.14159265 !0.
    ymax   =  1.7832 !3.14159265 !6.2831853
    bnd_xl = "outd"
    bnd_xr = "outd"
    bnd_yl = "outd"
    bnd_yr = "outd"
 /

 $UNITS
    units_set = "cgs"
 /

 $RESTART_CONTROL
    restart  = 'none'
    res_id   = ''
 /

 $END_CONTROL
    tend   = 0.0
    nend   = 0
 /

 $OUTPUT_CONTROL
    problem_name = 'mandelbrot_polar'
    run_id =  'fpq'
    use_v2_io = .true.
    dt_hdf  = 0.5
    vars(1:) = 'mand', 'dist', 'ang', 'level'
 /

 $PROBLEM_CONTROL
    maxiter = 50000
    ref_thr = 0.5
    !smooth_map = .false.
    log_polar = .true.
    precision = 'quad'
    x_center = "-1.99637859830127622318041140356304662056545479566444217157832784805"
    y_center = "-0.00009846411789164279281147049701099777327914008761108428659555385"

    c_polar = 0.26
 /

! String accuracy check
!               x_polar                                        y_polar
! char(len=32)  -0.16337093430484253886831311185               1.026178602930346497605177946429
! real(16)      -0.1633709343048425388683131118500000103       1.0261786029303464976051779464289999446
! real(10)      -0.1633709343048425388677299258111119684       1.0261786029303464975754450749789725705
! real(8)       -0.1633709343048425355338082454181858338       1.0261786029303465728190758454729802906
! real(4)       -0.1633709371089935302734375000000000000       1.0261785984039306640625000000000000000

 $INTERACTIONS
 /

 $AMR
    bsize = 3*8
    level_max = 3
    n_updAMR = 1
 /

!../../visual/pvf.py mandelbrot_polar_fpq_0000.h5 -d mand -D nipy_spectral -z 1,2.5
